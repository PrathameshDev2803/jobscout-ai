# Owner/workspace Gemini key (never exposed to visitors)
GEMINI_API_KEY=

# Low-quota key used only for public onboarding resume categorization.
# Use a separate Google AI Studio project so public uploads cannot spend the
# owner workspace quota. Leave empty to let public uploads use local fallback.
GEMINI_PUBLIC_API_KEY=

# Password that unlocks owner mode. Leave empty to run demo-only.
OWNER_PASSWORD=
